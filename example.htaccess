# Apache .htaccess config to ensure PHP has the necessary
# environment variables available.
# Generated by beporter/domain_voting:upload.sh

SetEnv DEBUG ${DEBUG}
SetEnv VOTING_DB_PATH '../voting.sqlite3'
SetEnv PAGE_TITLE '${PAGE_TITLE}'
SetEnv LEADERBOARD_LIMIT ${LEADERBOARD_LIMIT}
SetEnv DISPLAY_PRICES ${DISPLAY_PRICES}
SetEnv RATE_LIMIT_PAUSE_SECS ${RATE_LIMIT_PAUSE_SECS}

SetEnv PREFIXES '${PREFIXES}'
SetEnv SUFFIXES '${SUFFIXES}'
SetEnv TLDS '${TLDS}'

SetEnv BIAS_EXISTING_PROB ${BIAS_EXISTING_PROB}
SetEnv PAIRWISE_PROB ${PAIRWISE_PROB}
SetEnv ARRAY_WEIGHT_FACTOR ${ARRAY_WEIGHT_FACTOR}
SetEnv VOTE_COUNT_FACTOR ${VOTE_COUNT_FACTOR}
SetEnv ELO_SCORE_FACTOR ${ELO_SCORE_FACTOR}
SetEnv YEAR1_PRICE_FACTOR ${YEAR1_PRICE_FACTOR}
SetEnv RENEWAL_PRICE_FACTOR ${RENEWAL_PRICE_FACTOR}

### Actual (semi-)secrets.
SetEnv PORKBUN_API_TOKEN '${PORKBUN_API_TOKEN}'
SetEnv PORKBUN_SECRET_API_TOKEN '${PORKBUN_SECRET_API_TOKEN}'
